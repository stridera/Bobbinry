#!/usr/bin/env bash
set -euo pipefail

# Pre-commit checks — mirrors the /deploy skill checks.
# Skip with: git commit --no-verify (use sparingly)

echo "Running pre-commit checks..."

echo "  [1/9] Lockfile freshness..."
bun install --frozen-lockfile > /dev/null 2>&1 || {
  echo "    Lockfile is out of date. Run 'bun install' and commit bun.lock."
  exit 1
}

echo "  [2/9] Schema drift check..."
cd apps/api && bun run db:check-drift
cd "$OLDPWD"

echo "  [3/9] Lint..."
bunx turbo lint

echo "  [4/9] Bobbin lint..."
bun run lint:bobbins

echo "  [5/9] Vercel compat..."
./scripts/check-vercel-compat.sh

echo "  [6/9] API boundaries (logging, env)..."
./scripts/check-api-boundaries.sh

echo "  [7/9] Dockerfile workspaces..."
./scripts/check-dockerfile-workspaces.sh
./scripts/check-api-bobbin-imports.sh

echo "  [8/9] Typecheck..."
bun run typecheck

echo "  [9/9] Build (into .next-precommit so a running dev server is untouched)..."
NEXT_DIST_DIR=.next-precommit bun run build

echo "All pre-commit checks passed."
