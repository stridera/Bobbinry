{
  "name": "@bobbinry/monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modular, open-source tools for writers and worldbuilders",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*",
    "bobbins/*",
    "infra/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:check-drift": "turbo db:check-drift",
    "verify": "turbo lint db:check-drift typecheck",
    "test": "turbo test",
    "test:integration": "bun run --cwd apps/api test:integration",
    "start": "./dev-start.sh",
    "stop": "./dev-stop.sh",
    "stop:all": "./dev-stop.sh --containers",
    "status": "./dev-stop.sh --status",
    "create-bobbin": "node scripts/create-bobbin.js",
    "lint:bobbins": "bun scripts/lint-bobbins.ts",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "keywords": [
    "writing",
    "worldbuilding",
    "modular",
    "bobbins"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.13",
  "overrides": {
    "esbuild": ">=0.28.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "minimatch": ">=10.2.3",
    "brace-expansion": ">=5.0.8",
    "fast-uri": ">=4.1.5",
    "postcss": ">=8.5.26",
    "qs": ">=6.15.4",
    "ws": ">=8.20.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.7",
    "dompurify": ">=3.4.17",
    "find-my-way": ">=9.10.0",
    "undici": "^7.29.1",
    "axios": ">=1.20.0",
    "@xmldom/xmldom": "^0.8.15",
    "follow-redirects": ">=1.16.1",
    "form-data": ">=4.0.6",
    "js-yaml": "^3.15.2",
    "ip-address": ">=10.7.4",
    "source-map-js": ">=1.2.2",
    "@babel/core": "^7.29.7",
    "browserslist": ">=4.28.9",
    "baseline-browser-mapping": ">=2.11.0",
    "handlebars": ">=4.7.10",
    "postcss-selector-parser": ">=7.1.6",
    "@humanfs/node": "^0.16.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  }
}
