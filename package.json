{
  "name": "@bobbinry/monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modular, open-source tools for writers and worldbuilders",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*",
    "bobbins/*",
    "infra/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:check-drift": "turbo db:check-drift",
    "verify": "turbo lint db:check-drift typecheck",
    "test": "turbo test",
    "test:integration": "bun run --cwd apps/api test:integration",
    "start": "./dev-start.sh",
    "stop": "./dev-stop.sh",
    "stop:all": "./dev-stop.sh --containers",
    "status": "./dev-stop.sh --status",
    "create-bobbin": "node scripts/create-bobbin.js",
    "lint:bobbins": "bun scripts/lint-bobbins.ts",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "keywords": [
    "writing",
    "worldbuilding",
    "modular",
    "bobbins"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.13",
  "overrides": {
    "esbuild": ">=0.25.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "minimatch": ">=10.2.3",
    "brace-expansion": ">=5.0.6",
    "fast-uri": ">=3.1.2",
    "postcss": ">=8.5.26",
    "qs": ">=6.15.2",
    "ws": ">=8.20.1",
    "prosemirror-model": "1.25.11",
    "prosemirror-transform": "1.12.0",
    "prosemirror-view": "1.41.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
