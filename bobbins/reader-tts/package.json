{
  "name": "@bobbinry/reader-tts",
  "version": "1.0.0",
  "description": "Read Aloud: browser text-to-speech controls for the Bobbinry reader",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./panels/*": "./src/panels/*.tsx"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@bobbinry/sdk": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "6.0.3"
  }
}
